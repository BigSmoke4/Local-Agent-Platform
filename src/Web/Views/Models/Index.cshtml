@model List<Platform.Web.Models.ModelDescriptor>
@{
    ViewData["Title"] = "Model Manager";
}

<h1 class="panel-title">Model Manager</h1>

<section class="panel panel--wide">
    <h2 class="panel__header">REGISTERED MODELS</h2>
    @if (Model.Any())
    {
        <table class="panel__table">
            <thead>
                <tr><th>Name</th><th>Runtime Id</th><th>Context</th><th>Quantization</th><th>Default</th></tr>
            </thead>
            <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Name</td>
                    <td>@m.RuntimeId</td>
                    <td>@m.ContextWindow</td>
                    <td>@(m.Quantization ?? "n/a")</td>
                    <td class="@(m.IsDefault ? "status-ok" : "")">@(m.IsDefault ? "YES" : "")</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p class="panel__empty">No models registered yet.</p>
    }
</section>

<section class="panel panel--wide" style="margin-top:20px">
    <h2 class="panel__header">REGISTER A MODEL</h2>
    <p class="panel__empty">
        POST to <code>/api/models</code> with
        <code>{"name":"...", "runtimeId":"...", "contextWindow":8192, "quantization":"Q4_K_M"}</code>.
        The runtime id must match a model already pulled in Ollama
        (<code>ollama pull &lt;model&gt;</code>).
    </p>
</section>
