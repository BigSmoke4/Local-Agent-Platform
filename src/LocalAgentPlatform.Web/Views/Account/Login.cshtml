@{ ViewData["Title"] = "Log In"; Layout = "_AuthLayout"; }
<section class="panel" style="max-width:380px; margin:3rem auto;">
    <h2 class="panel__title">LOG IN</h2>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="status-fail" style="margin-bottom:0.5rem;">@ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage</div>
    }
    <form method="post" asp-action="Login" asp-route-returnUrl="@Context.Request.Query["returnUrl"]">
        <input type="text" name="userName" placeholder="Username" style="width:100%; margin-bottom:0.5rem;" required autofocus />
        <input type="password" name="password" placeholder="Password" style="width:100%; margin-bottom:0.5rem;" required />
        <button type="submit" class="btn-small">Log In</button>
    </form>
    <p style="font-size:0.8rem; margin-top:1rem;"><a href="@Url.Action("Register")">Register</a> (only available before the first account is created, or when already logged in)</p>
</section>
