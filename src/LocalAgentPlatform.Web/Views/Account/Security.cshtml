@model LocalAgentPlatform.Shared.Data.Entities.AppUser
@{ ViewData["Title"] = "Account Security"; }
<section class="panel">
    <h2 class="panel__title">ACCOUNT SECURITY</h2>
    <p>Role: <strong>@Model.Role</strong> · MFA: <strong>@(Model.MfaEnabled ? "Enabled" : "Disabled")</strong></p>
    @if (TempData["SecurityError"] is string err) { <div class="status-fail">@err</div> }
    @if (TempData["MfaSecret"] is string secret)
    {
        <p>Add this secret to any TOTP authenticator, then enter the current six-digit code below:</p>
        <pre style="user-select:all">@secret</pre>
        <form method="post" asp-action="ConfirmMfa"><input name="code" maxlength="6" required /><button class="btn-small">Confirm MFA</button></form>
    }
    else if (!Model.MfaEnabled)
    {
        <form method="post" asp-action="BeginMfa"><button class="btn-small">Set up MFA</button></form>
    }
    else
    {
        <form method="post" asp-action="DisableMfa"><input type="password" name="password" placeholder="Password" required /><button class="btn-small">Disable MFA</button></form>
    }
</section>
