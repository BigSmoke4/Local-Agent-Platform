@{
    // Which module is "active" is derived from the real current controller name —
    // not a hard-coded guess — so highlighting always matches where the user actually is.
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string NodeClass(string controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase) ? "neural-node neural-node--active" : "neural-node";
}
<nav class="neural-nav" aria-label="Primary">
    <svg viewBox="0 0 900 220" class="neural-nav__svg" role="img" aria-label="Module navigation graph" preserveAspectRatio="xMidYMid meet">
        <!-- connection lines from the central AI CORE node to each module -->
        <g class="neural-nav__links" stroke="var(--panel-border)" stroke-width="1.5" fill="none">
            <line x1="450" y1="110" x2="80"  y2="40" />
            <line x1="450" y1="110" x2="230" y2="40" />
            <line x1="450" y1="110" x2="380" y2="40" />
            <line x1="450" y1="110" x2="520" y2="40" />
            <line x1="450" y1="110" x2="670" y2="40" />
            <line x1="450" y1="110" x2="820" y2="40" />
            <line x1="450" y1="110" x2="150" y2="180" />
            <line x1="450" y1="110" x2="450" y2="180" />
            <line x1="450" y1="110" x2="750" y2="180" />
        </g>

        <!-- central node -->
        <g class="neural-node neural-node--core" transform="translate(450,110)">
            <circle r="26" />
            <text y="4" text-anchor="middle">CORE</text>
        </g>

        <!-- module nodes: each is a real link, not decoration -->
        <a href="@Url.Action("Index", "Dashboard")">
            <g class="@NodeClass("Dashboard")" transform="translate(80,40)">
                <circle r="20" /><text y="4" text-anchor="middle">Dash</text>
            </g>
        </a>
        <a href="@Url.Action("Index", "ModelManager")">
            <g class="@NodeClass("ModelManager")" transform="translate(230,40)">
                <circle r="20" /><text y="4" text-anchor="middle">Models</text>
            </g>
        </a>
        <a href="@Url.Action("Index", "Repositories")">
            <g class="@NodeClass("Repositories")" transform="translate(380,40)">
                <circle r="20" /><text y="4" text-anchor="middle">Repo</text>
            </g>
        </a>
        <a href="@Url.Action("Index", "Tools")">
            <g class="@NodeClass("Tools")" transform="translate(520,40)">
                <circle r="20" /><text y="4" text-anchor="middle">Tools</text>
            </g>
        </a>
        <a href="@Url.Action("Index", "Agent")">
            <g class="@NodeClass("Agent")" transform="translate(670,40)">
                <circle r="20" /><text y="4" text-anchor="middle">Agent</text>
            </g>
        </a>
        <a href="@Url.Action("Index", "Memory")">
            <g class="@NodeClass("Memory")" transform="translate(820,40)">
                <circle r="20" /><text y="4" text-anchor="middle">Memory</text>
            </g>
        </a>
        <a href="/swagger">
            <g class="neural-node" transform="translate(150,180)">
                <circle r="20" /><text y="4" text-anchor="middle">API</text>
            </g>
        </a>
        <a href="@Url.Action("Index", "Agent")">
            <g class="neural-node" transform="translate(450,180)">
                <circle r="20" /><text y="4" text-anchor="middle">Verify</text>
            </g>
        </a>
        <a href="/health/ready">
            <g class="neural-node" transform="translate(750,180)">
                <circle r="20" /><text y="4" text-anchor="middle">Health</text>
            </g>
        </a>
    </svg>
</nav>
