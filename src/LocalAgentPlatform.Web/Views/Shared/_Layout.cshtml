<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Local Agent Platform</title>
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body data-agent-session-id="@(ViewData["AgentSessionId"] ?? "")">
    <header class="console-header">
        <span class="console-header__title">AI CORE</span>
        <span class="console-header__subtitle">Local Autonomous Coding Intelligence Platform</span>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <form method="post" asp-controller="Account" asp-action="Logout" style="margin-left:auto; display:flex; align-items:center; gap:0.5rem;">
                <span style="font-size:0.75rem; color:var(--text-muted);">@User.Identity!.Name</span>
                <a href="/ApiKeys" style="font-size:0.75rem;">API Keys</a>
                <button type="submit" class="btn-small">Log out</button>
            </form>
        }
    </header>
    <nav class="console-nav" aria-label="Text navigation (fallback)">
        <a href="/Dashboard">Dashboard</a>
        <a href="/ModelManager">Model Manager</a>
        <a href="/Repositories">Repositories</a>
        <a href="/Tools">Tools</a>
        <a href="/Agent">Agent</a>
        <a href="/Memory">Memory</a>
    </nav>
    @await Html.PartialAsync("_NeuralNav")
    <main class="console-main">
        @RenderBody()
    </main>
    <script src="~/js/app.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
