@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="panel-title">AI Core — Dashboard</h1>

<div class="panel-grid">

    <section class="panel">
        <h2 class="panel__header">MODEL STATUS</h2>
        @if (Model.DefaultModel is not null)
        {
            <div class="metric-row"><span>Model</span><strong>@Model.DefaultModel.Name</strong></div>
            <div class="metric-row"><span>Runtime Id</span><strong>@Model.DefaultModel.RuntimeId</strong></div>
            <div class="metric-row"><span>Context</span><strong>@Model.DefaultModel.ContextWindow</strong></div>
            <div class="metric-row"><span>Quantization</span><strong>@(Model.DefaultModel.Quantization ?? "n/a")</strong></div>
        }
        else
        {
            <p class="panel__empty">No default model registered. POST /api/models to register one.</p>
        }
        <div class="metric-row">
            <span>Runtime Health</span>
            <strong class="@(Model.ModelRuntimeHealthy ? "status-ok" : "status-fail")">
                @(Model.ModelRuntimeHealthy ? "READY" : "UNAVAILABLE")
            </strong>
        </div>
        @if (!Model.ModelRuntimeHealthy && Model.ModelRuntimeMessage is not null)
        {
            <p class="panel__empty">@Model.ModelRuntimeMessage</p>
        }
    </section>

    <section class="panel">
        <h2 class="panel__header">HARDWARE (LIVE)</h2>
        <div class="metric-row"><span>CPU</span><strong data-telemetry-cpu>—</strong></div>
        <p class="panel__empty">GPU: Unavailable (no vendor tooling configured)</p>
    </section>

    <section class="panel">
        <h2 class="panel__header">AGENT</h2>
        <div class="metric-row"><span>Total Sessions</span><strong>@Model.TotalAgentSessions</strong></div>
        <div class="metric-row"><span>Active Sessions</span><strong>@Model.ActiveAgentSessions</strong></div>
        @if (Model.LatestSession is not null)
        {
            <div class="metric-row"><span>Latest State</span><strong>@Model.LatestSession.State</strong></div>
            <div class="metric-row"><span>Latest Request</span><strong>@Model.LatestSession.UserRequest</strong></div>
        }
        else
        {
            <p class="panel__empty">No agent sessions yet. POST /api/agent/run to start one.</p>
        }
    </section>

    <section class="panel">
        <h2 class="panel__header">TOOL EXECUTIONS</h2>
        <div class="metric-row"><span>Total</span><strong>@Model.TotalToolExecutions</strong></div>
        <div class="metric-row"><span>Failed</span><strong>@Model.FailedToolExecutions</strong></div>
    </section>

    <section class="panel panel--wide">
        <h2 class="panel__header">AVAILABLE LOCAL MODELS (RUNTIME)</h2>
        @if (Model.AvailableRuntimeModels.Any())
        {
            <ul class="panel__list">
                @foreach (var m in Model.AvailableRuntimeModels)
                {
                    <li>@m</li>
                }
            </ul>
        }
        else
        {
            <p class="panel__empty">No models reported by runtime. Is Ollama running (ollama serve)?</p>
        }
    </section>

    <section class="panel panel--wide">
        <h2 class="panel__header">RECENT AUDIT LOG</h2>
        @if (Model.RecentAuditLogs.Any())
        {
            <table class="panel__table">
                <thead><tr><th>Time (UTC)</th><th>Action</th><th>Details</th></tr></thead>
                <tbody>
                @foreach (var log in Model.RecentAuditLogs)
                {
                    <tr>
                        <td>@log.OccurredAtUtc.ToString("u")</td>
                        <td>@log.Action</td>
                        <td>@log.Details</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="panel__empty">No audit entries yet.</p>
        }
    </section>

</div>
