<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Namespace intentionally stays Platform.Web.Services.Tools — see
         docs/MODULE_SPLIT.md. Physical project boundary is what matters
         for "modular monolith"; renaming the namespace is optional and
         not done here to keep every existing `using` statement in Web
         and Platform.Tests valid without any further changes. -->
    <RootNamespace>Platform.Web.Services.Tools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
  </ItemGroup>

</Project>
