@model MemoryIndexViewModel
@{
    ViewData["Title"] = "Memory";
}

@if (TempData["MemoryError"] is string err && !string.IsNullOrEmpty(err))
{
    <section class="panel"><div class="panel__row"><span class="status-fail">Error</span><span>@err</span></div></section>
}

<section class="panel">
    <h2 class="panel__title">FILTER</h2>
    <form method="get" asp-action="Index" style="display:flex; gap:0.5rem;">
        <select name="repositoryId" onchange="this.form.submit()">
            <option value="">All repositories</option>
            @foreach (var r in Model.Repositories)
            {
                <option value="@r.Id" selected="@(Model.SelectedRepositoryId == r.Id)">@r.LocalPath</option>
            }
        </select>
    </form>
</section>

<section class="panel">
    <h2 class="panel__title">ADD MEMORY (LongTerm / UserPreference / Working)</h2>
    <p style="font-size:0.75rem; color:var(--text-muted);">
        Execution memory is written automatically by the Agent Engine after every session — this form is for manual notes.
    </p>
    <form method="post" asp-action="Add">
        <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:0.5rem;">
            <select name="scope" required>
                <option value="LongTerm">LongTerm (architecture decision)</option>
                <option value="UserPreference">UserPreference</option>
                <option value="Working">Working (current investigation)</option>
            </select>
            <select name="repositoryId">
                <option value="">(not repository-specific)</option>
                @foreach (var r in Model.Repositories)
                {
                    <option value="@r.Id">@r.LocalPath</option>
                }
            </select>
            <input type="number" name="baseImportance" min="0" max="1" step="0.1" value="0.5" title="Base importance 0.0–1.0" style="width:90px;" />
        </div>
        <input type="text" name="title" placeholder="Title" style="width:100%; margin-bottom:0.5rem;" required />
        <textarea name="content" placeholder="Content" rows="3" style="width:100%; margin-bottom:0.5rem;" required></textarea>
        <input type="text" name="tags" placeholder="tags (comma separated, optional)" style="width:100%; margin-bottom:0.5rem;" />
        <button type="submit" class="btn-small">Add</button>
    </form>
</section>

<section class="panel">
    <h2 class="panel__title">ENTRIES (most recent 100)</h2>
    <table class="data-table">
        <thead><tr><th>Scope</th><th>Title</th><th>Content</th><th>Importance</th><th>Accessed</th><th>Created</th></tr></thead>
        <tbody>
        @foreach (var m in Model.Entries)
        {
            <tr>
                <td>@m.Scope</td>
                <td>@m.Title</td>
                <td style="max-width:400px; white-space:pre-wrap;">@(m.Content.Length > 200 ? m.Content[..200] + "…" : m.Content)</td>
                <td>@m.BaseImportance.ToString("0.0")</td>
                <td>@m.AccessCount@(m.LastAccessedAtUtc is not null ? $" (last {m.LastAccessedAtUtc:u})" : "")</td>
                <td>@m.CreatedAtUtc.ToString("u")</td>
            </tr>
        }
        @if (!Model.Entries.Any())
        {
            <tr><td colspan="6">No memory entries yet.</td></tr>
        }
        </tbody>
    </table>
</section>
