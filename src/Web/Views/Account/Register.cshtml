@{
    ViewData["Title"] = "Register";
}
<h1 class="panel-title">Create Account</h1>
<section class="panel" style="max-width:360px">
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="metric-row"><label for="Email">Email</label></div>
        <input class="console-input" type="email" id="Email" name="Email" required />
        <div class="metric-row"><label for="Password">Password (min 8 chars)</label></div>
        <input class="console-input" type="password" id="Password" name="Password" required minlength="8" />
        <button class="console-btn" type="submit" style="margin-top:16px">Register</button>
    </form>
</section>
