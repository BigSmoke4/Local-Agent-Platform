@{ ViewData["Title"] = "Reset Password"; Layout = "_AuthLayout"; }
<section class="panel" style="max-width:420px; margin:3rem auto;">
    <h2 class="panel__title">RESET PASSWORD</h2>
    @if (!ViewData.ModelState.IsValid) { <div class="status-fail">@ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage</div> }
    <form method="post">
        <input name="userName" placeholder="Username" required style="width:100%;margin-bottom:.5rem" />
        <input name="recoveryCode" placeholder="Recovery code" required style="width:100%;margin-bottom:.5rem" />
        <input type="password" name="newPassword" placeholder="New password (12+ characters)" minlength="12" required style="width:100%;margin-bottom:.5rem" />
        <button class="btn-small" type="submit">Reset password</button>
    </form>
</section>
