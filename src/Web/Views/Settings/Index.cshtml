@model Platform.Web.Models.AutonomyLevel
@{
    ViewData["Title"] = "Settings";
}

<h1 class="panel-title">Settings</h1>

<section class="panel" style="max-width:420px">
    <h2 class="panel__header">AUTONOMY LEVEL</h2>
    <p class="panel__empty">
        Current: <strong class="status-ok">@Model</strong>
    </p>
    <p class="panel__empty">
        <strong>Low</strong>: the verification loop's automated repair step
        is skipped entirely — no file edit happens without you raising this.<br />
        <strong>Medium/High</strong>: automated repair is permitted during
        <code>run-verified</code>.
    </p>
    <form method="post" action="/settings/autonomy">
        @Html.AntiForgeryToken()
        <select name="level" class="console-input">
            <option value="Low" selected="@(Model == Platform.Web.Models.AutonomyLevel.Low)">Low</option>
            <option value="Medium" selected="@(Model == Platform.Web.Models.AutonomyLevel.Medium)">Medium</option>
            <option value="High" selected="@(Model == Platform.Web.Models.AutonomyLevel.High)">High</option>
        </select>
        <button type="submit" class="console-btn" style="margin-top:10px">Save</button>
    </form>
</section>
