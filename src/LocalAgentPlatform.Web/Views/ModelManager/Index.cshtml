@model LocalAgentPlatform.Modules.Models.Application.Services.ModelManagerViewData
@{
    ViewData["Title"] = "Model Manager";
    string Bytes(long? b) => b.HasValue ? $"{b.Value / 1024.0 / 1024.0 / 1024.0:0.00} GB" : "Unavailable";
    string FitnessLabel(LocalAgentPlatform.Modules.Models.Domain.ModelFitness f) => f switch
    {
        LocalAgentPlatform.Modules.Models.Domain.ModelFitness.Recommended => "RECOMMENDED",
        LocalAgentPlatform.Modules.Models.Domain.ModelFitness.Fits => "FITS",
        LocalAgentPlatform.Modules.Models.Domain.ModelFitness.PossibleButSlower => "POSSIBLE — SLOWER",
        LocalAgentPlatform.Modules.Models.Domain.ModelFitness.TooLarge => "TOO LARGE",
        _ => "UNKNOWN"
    };
    string FitnessClass(LocalAgentPlatform.Modules.Models.Domain.ModelFitness f) => f switch
    {
        LocalAgentPlatform.Modules.Models.Domain.ModelFitness.Recommended => "status-ok",
        LocalAgentPlatform.Modules.Models.Domain.ModelFitness.TooLarge => "status-fail",
        _ => "status-warn"
    };
}

<section class="panel">
    <h2 class="panel__title">HARDWARE-AWARE RECOMMENDATION</h2>
    <div class="panel__row"><span>Available RAM</span><span>@Bytes(Model.AvailableRamBytes)</span></div>
    <div class="panel__row"><span>Recommendation</span><span>@Model.RecommendationMessage</span></div>
</section>

@if (TempData["LoadResult"] is string loadResult)
{
    <section class="panel"><div class="panel__row"><span>Last action</span><span>@loadResult</span></div></section>
}

<section class="panel">
    <h2 class="panel__title">REGISTERED MODELS</h2>
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th><th>Provider Model Id</th><th>Quantization</th><th>Context</th>
                <th>In Runtime?</th><th>Fitness</th><th>Default</th><th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.Registered.Name</td>
                <td>@row.Registered.ModelId</td>
                <td>@(row.Registered.Quantization ?? "n/a")</td>
                <td>@(row.Registered.ContextWindow?.ToString() ?? "n/a")</td>
                <td class="@(row.AvailableInRuntime ? "status-ok" : "status-fail")">@(row.AvailableInRuntime ? "YES" : "NOT PULLED")</td>
                <td class="@FitnessClass(row.Fitness)">@FitnessLabel(row.Fitness)</td>
                <td>@(row.Registered.IsDefault ? "★ DEFAULT" : "")</td>
                <td class="actions-cell">
                    <form method="post" asp-action="SetDefault" class="inline-form">
                        <input type="hidden" name="id" value="@row.Registered.Id" />
                        <button type="submit" class="btn-small">Set Default</button>
                    </form>
                    <form method="post" asp-action="Load" class="inline-form">
                        <input type="hidden" name="modelId" value="@row.Registered.ModelId" />
                        <button type="submit" class="btn-small">Load</button>
                    </form>
                    <form method="post" asp-action="Unload" class="inline-form">
                        <input type="hidden" name="modelId" value="@row.Registered.ModelId" />
                        <button type="submit" class="btn-small">Unload</button>
                    </form>
                    <form method="post" asp-action="Delete" class="inline-form" onsubmit="return confirm('Remove this model from the registry?');">
                        <input type="hidden" name="id" value="@row.Registered.Id" />
                        <button type="submit" class="btn-small btn-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Rows.Any())
        {
            <tr><td colspan="8">No models registered yet. Register one from the runtime list below.</td></tr>
        }
        </tbody>
    </table>
</section>

<section class="panel">
    <h2 class="panel__title">MODELS AVAILABLE IN RUNTIME (not yet registered)</h2>
    <table class="data-table">
        <thead><tr><th>Runtime Model Id</th><th>Quantization</th><th>Est. Size</th><th>Actions</th></tr></thead>
        <tbody>
        @foreach (var m in Model.UnregisteredRuntimeModels)
        {
            <tr>
                <td>@m.Id</td>
                <td>@(m.Quantization ?? "n/a")</td>
                <td>@Bytes(m.FileSizeBytes)</td>
                <td>
                    <form method="post" asp-action="Register" class="inline-form">
                        <input type="hidden" name="runtimeModelId" value="@m.Id" />
                        <button type="submit" class="btn-small">Register</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.UnregisteredRuntimeModels.Any())
        {
            <tr><td colspan="4">Nothing new — every model Ollama reports is already registered, or Ollama is unreachable.</td></tr>
        }
        </tbody>
    </table>
</section>
