@model AgentDetailsViewModel
@{
    ViewData["Title"] = "Agent Session";
    ViewData["AgentSessionId"] = Model.Session.Id;
    var s = Model.Session;
}

<section class="panel">
    <h2 class="panel__title">SESSION</h2>
    <div class="panel__row"><span>Request</span><span>@s.UserRequest</span></div>
    <div class="panel__row">
        <span>State</span>
        <span class="@(s.State == "Completed" ? "status-ok" : s.State is "Failed" or "Cancelled" ? "status-fail" : "status-warn")">
            @s.State @(Model.IsRunning ? "(running)" : "")
        </span>
    </div>
    <div class="panel__row"><span>Model</span><span>@s.ModelIdUsed</span></div>
    <div class="panel__row"><span>Iterations used</span><span>@s.IterationCount / @s.MaxIterations</span></div>
    <div class="panel__row"><span>Repair attempts used</span><span>@s.RepairAttemptCount / @s.MaxRepairAttempts</span></div>
    @if (!string.IsNullOrEmpty(s.FailureReason))
    {
        <div class="panel__row"><span>Failure reason</span><span class="status-fail">@s.FailureReason</span></div>
    }
    @if (Model.IsRunning)
    {
        <form method="post" asp-action="Cancel" style="margin-top:0.5rem;">
            <input type="hidden" name="sessionId" value="@s.Id" />
            <button type="submit" class="btn-small btn-danger">Cancel</button>
        </form>
    }
    <p style="font-size:0.75rem; color:var(--text-muted); margin-top:0.5rem;">
        This page refreshes automatically a moment after the session changes (via SignalR). If it seems stuck, reload manually.
    </p>
</section>

@if (!string.IsNullOrEmpty(s.FinalSummary))
{
    <section class="panel">
        <h2 class="panel__title">FINAL SUMMARY</h2>
        <pre style="white-space:pre-wrap; font-size:0.85rem;">@s.FinalSummary</pre>
    </section>
}

<section class="panel">
    <h2 class="panel__title">TASK GRAPH (linear chain)</h2>
    <table class="data-table">
        <thead><tr><th>#</th><th>Type</th><th>Description</th><th>Tool</th><th>Status</th><th>Retries</th><th></th></tr></thead>
        <tbody>
        @foreach (var t in Model.Tasks)
        {
            <tr>
                <td>@t.OrderIndex</td>
                <td>@t.Type</td>
                <td>@t.Description</td>
                <td>@(t.ToolName ?? "—")</td>
                <td class="@(t.Status == "Completed" ? "status-ok" : t.Status is "Failed" ? "status-fail" : "status-warn")">@t.Status</td>
                <td>@t.RetryCount</td>
                <td>
                    @if (t.Status == "AwaitingApproval")
                    {
                        <form method="post" asp-action="Approve">
                            <input type="hidden" name="sessionId" value="@s.Id" />
                            <input type="hidden" name="taskId" value="@t.Id" />
                            <button type="submit" class="btn-small" style="border-color:var(--danger);">Approve &amp; Run</button>
                        </form>
                    }
                </td>
            </tr>
            @if (t.Output is not null || t.Error is not null)
            {
                <tr>
                    <td></td>
                    <td colspan="6">
                        @if (t.Output is not null)
                        {
                            <pre style="white-space:pre-wrap; font-size:0.75rem; max-height:150px; overflow:auto;">@t.Output</pre>
                        }
                        @if (t.Error is not null)
                        {
                            <pre style="white-space:pre-wrap; font-size:0.75rem; color:var(--danger); max-height:150px; overflow:auto;">@t.Error</pre>
                        }
                    </td>
                </tr>
            }
        }
        @if (!Model.Tasks.Any())
        {
            <tr><td colspan="7">No tasks yet — still planning, or planning failed (see PlanJson below).</td></tr>
        }
        </tbody>
    </table>
</section>

@if (Model.VerificationRuns.Any())
{
    <section class="panel">
        <h2 class="panel__title">VERIFICATION RUNS</h2>
        <table class="data-table">
            <thead><tr><th>Attempt</th><th>Build</th><th>Errors/Warnings</th><th>Tests</th><th>Security</th><th>Reviewer</th><th>Result</th></tr></thead>
            <tbody>
            @foreach (var v in Model.VerificationRuns)
            {
                <tr>
                    <td>@v.RepairAttemptNumber</td>
                    <td class="@(v.BuildPassed == true ? "status-ok" : "status-fail")">@(v.BuildPassed == true ? "PASS" : "FAIL")</td>
                    <td>@v.CompilerErrorCount / @v.CompilerWarningCount</td>
                    <td>@(v.TestsRan == true ? v.TestOutputSummary : "not run")</td>
                    <td class="@(v.SecurityFindingCount > 0 ? "status-warn" : "status-ok")">@v.SecurityFindingCount finding(s)</td>
                    <td class="@(v.ReviewerVerdict == "Rejected" ? "status-fail" : "status-ok")">@v.ReviewerVerdict</td>
                    <td class="@(v.OverallResult == "Passed" ? "status-ok" : "status-fail")">@v.OverallResult</td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}

@if (!string.IsNullOrEmpty(s.PlanJson))
{
    <section class="panel">
        <h2 class="panel__title">RAW PLAN</h2>
        <pre style="white-space:pre-wrap; font-size:0.75rem; max-height:250px; overflow:auto;">@s.PlanJson</pre>
    </section>
}

@if (Model.TokenUsage.Any())
{
    <section class="panel">
        <h2 class="panel__title">TOKEN USAGE</h2>
        <table class="data-table">
            <thead><tr><th>Input</th><th>Output</th><th>Tokens/sec</th><th>Time to first token</th></tr></thead>
            <tbody>
            @foreach (var u in Model.TokenUsage)
            {
                <tr>
                    <td>@u.InputTokens</td>
                    <td>@u.OutputTokens</td>
                    <td>@u.TokensPerSecond.ToString("0.0")</td>
                    <td>@(u.TimeToFirstToken.HasValue ? $"{u.TimeToFirstToken.Value.TotalMilliseconds:0} ms" : "n/a")</td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}

@section Scripts {
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/agent-live.js"></script>
}
