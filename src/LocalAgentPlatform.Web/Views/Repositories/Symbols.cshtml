@model IReadOnlyList<LocalAgentPlatform.Shared.Data.Entities.CodeSymbol>
@{
    ViewData["Title"] = "Code Symbols";
}

<section class="panel">
    <h2 class="panel__title">SYMBOL INDEX — @ViewBag.RepositoryPath</h2>
    <p style="color: var(--text-muted); font-size: 0.8rem;">
        Showing up to 500 symbols extracted by Roslyn from C# files. Cross-file semantic
        relationships (calls/implements graph) are not built yet — see docs/STATUS.md.
    </p>
    <table class="data-table">
        <thead><tr><th>Namespace</th><th>Type</th><th>Kind</th><th>Name</th><th>Signature</th><th>Line</th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@(s.ContainingNamespace ?? "—")</td>
                <td>@(s.ContainingTypeName ?? "—")</td>
                <td>@s.Kind</td>
                <td>@s.Name</td>
                <td>@s.Signature</td>
                <td>@s.LineNumber</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6">No symbols indexed yet — click "Index Now" on the Repositories page.</td></tr>
        }
        </tbody>
    </table>
</section>
